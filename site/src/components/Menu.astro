---
import {urlFor} from '../lib/sanity'

interface MenuItem {
  _id: string
  name: string
  description?: string
  price: number
  priceVariants?: {label: string; price: number}[]
  image?: unknown
  available?: boolean
  tags?: string[]
}

interface MenuCategory {
  _id: string
  title: string
  description?: string
  items: MenuItem[]
}

interface Props {
  categories: MenuCategory[]
}

const {categories} = Astro.props

function formatPrice(price: number): string {
  return `$${price.toFixed(2)}`
}
---

<section class="menu container" id="menu">
  <div class="menu-heading">
    <h2>Menu</h2>
    <span class="menu-note annotation" aria-hidden="true">today's board</span>
  </div>
  {categories.map((category, index) => (
    <div class="category" id={category._id} data-reveal>
      <div class="category-heading">
        <svg class="category-icon" viewBox="0 0 48 48" aria-hidden="true">
          {index % 3 === 0 ? (
            <path
              d="M9 18h22v9c0 6-5 11-11 11S9 33 9 27v-9Z M31 20h5c3 0 5 2 5 5s-2 5-5 5h-5 M13 12c1-2 0-3 1-5 M20 12c1-2 0-3 1-5 M27 12c1-2 0-3 1-5"
              filter="url(#ink-wobble)"
            />
          ) : index % 3 === 1 ? (
            <path
              d="M24 6c8 4 12 11 12 18 0 7-5 12-12 12S12 31 12 24c0-7 4-14 12-18Z M24 20v20"
              filter="url(#ink-wobble)"
            />
          ) : (
            <path
              d="M8 26c0-8 7-16 16-16s16 8 16 16c0 2-2 3-4 2-3-2-6 0-9 2-3 2-5 2-8 0-3-2-6-4-9-2-2 1-4 0-2-2Z M12 30c2 4 6 7 12 7s10-3 12-7"
              filter="url(#ink-wobble)"
            />
          )}
        </svg>
        <h3>{category.title}</h3>
      </div>
      {category.description && <p class="category-description">{category.description}</p>}
      <ul class="items">
        {category.items
          .filter((item) => item.available !== false)
          .map((item) => (
            <li class="item" data-reveal>
              {item.image && (
                <img
                  class="item-image"
                  src={urlFor(item.image).width(96).height(96).url()}
                  alt={item.name}
                  loading="lazy"
                />
              )}
              <div class="item-body">
                <div class="item-line">
                  <span class="item-name">{item.name}</span>
                  <span class="item-leader" aria-hidden="true"></span>
                  {!item.priceVariants?.length && (
                    <span class="item-price">{formatPrice(item.price)}</span>
                  )}
                </div>
                {item.description && <p class="item-description">{item.description}</p>}
                {item.priceVariants && item.priceVariants.length > 0 && (
                  <ul class="variants">
                    {item.priceVariants.map((variant) => (
                      <li>
                        {variant.label}: {formatPrice(variant.price)}
                      </li>
                    ))}
                  </ul>
                )}
                {item.tags && item.tags.length > 0 && (
                  <ul class="tags">
                    {item.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
      </ul>
      {index < categories.length - 1 && <hr class="ink-rule" />}
    </div>
  ))}
</section>

<script>
  import {revealOnScroll} from '../scripts/motion'

  document.querySelectorAll('.menu [data-reveal]').forEach((el, i) => {
    revealOnScroll(el, {y: 22, delay: (i % 6) * 0.03})
  })
</script>

<style>
  .menu {
    padding: var(--spacing-lg) var(--spacing-sm);
  }
  .menu-heading {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-md);
  }
  .menu-heading h2 {
    margin: 0;
  }
  .menu-note {
    font-size: 1.3rem;
    color: var(--color-text-muted);
    transform: rotate(-1.5deg);
  }
  .category {
    margin-bottom: var(--spacing-lg);
  }
  .category-heading {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }
  .category-icon {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }
  .category-icon path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .category-heading h3 {
    margin: 0;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .category-description {
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }
  .items {
    list-style: none;
    margin: var(--spacing-sm) 0 0;
    padding: 0;
  }
  .item {
    display: flex;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) 0;
    border-bottom: 1.5px dashed var(--color-border);
  }
  .item-image {
    width: 64px;
    height: 64px;
    border: 1.5px solid var(--color-border);
    object-fit: cover;
    flex-shrink: 0;
    filter: url(#ink-wobble);
  }
  .item-body {
    flex: 1;
    min-width: 0;
  }
  .item-line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
  }
  .item-name {
    flex-shrink: 0;
  }
  .item-leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1.5px dotted var(--color-text-muted);
    transform: translateY(-0.3em);
  }
  .item-price {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .item-description {
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .variants {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .tags {
    list-style: none;
    display: flex;
    gap: 0.6rem;
    margin: 0.4rem 0 0;
    padding: 0;
  }
  .tag {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-accent);
    position: relative;
  }
  .tag::before {
    content: '';
    position: absolute;
    left: -0.3rem;
    right: -0.3rem;
    top: -0.15rem;
    bottom: -0.05rem;
    border: 1.5px solid currentColor;
    border-radius: 999px;
    opacity: 0.7;
  }
  .ink-rule {
    margin: var(--spacing-lg) 0 0;
  }
</style>
