---
import {urlFor} from '../lib/sanity'

// Portable text blocks from the `page` schema's `body` field. Rendered as
// plain paragraphs — a café About section doesn't need rich formatting.
interface PortableTextBlock {
  _type: 'block'
  children?: {text: string}[]
}

interface Props {
  title: string
  body?: PortableTextBlock[]
  heroImage?: unknown
}

const {title, body, heroImage} = Astro.props
const imageUrl = heroImage ? urlFor(heroImage).width(800).url() : undefined

function blockText(block: PortableTextBlock): string {
  return block.children?.map((child) => child.text).join('') ?? ''
}
---

<section class="about container" id="about" data-reveal>
  <div class="about-heading">
    <h2>{title}</h2>
    <span class="pin" aria-hidden="true"></span>
  </div>
  {imageUrl && (
    <div class="frame" data-webgl-image>
      <img src={imageUrl} alt={title} loading="lazy" crossorigin="anonymous" />
      <canvas></canvas>
    </div>
  )}
  {body?.map((block) => <p>{blockText(block)}</p>)}
</section>

<script>
  import {revealOnScroll} from '../scripts/motion'

  const about = document.querySelector('#about')
  if (about) revealOnScroll(about, {clipFrom: 'inset(4% 0% 4% 0%)'})

  const frame = document.querySelector<HTMLElement>('[data-webgl-image]')
  const img = frame?.querySelector('img')
  const canvas = frame?.querySelector('canvas')
  if (frame && img && canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Three.js is only needed for this one hover effect, so it's a lazy
    // chunk rather than part of the shared bundle every page loads.
    const start = async () => {
      const {WebGLImageDistort} = await import('../scripts/webgl-image')
      new WebGLImageDistort(canvas, img)
      canvas.classList.add('is-active')
    }
    if (img.complete) start()
    else img.addEventListener('load', start, {once: true})
  }
</script>

<style>
  .about {
    padding: var(--spacing-lg) var(--spacing-sm);
    max-width: 640px;
  }
  .about-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .about-heading .pin {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .frame {
    position: relative;
    border: 1.5px solid var(--color-border);
    filter: url(#ink-wobble-lg);
    margin: var(--spacing-sm) 0;
    transform: rotate(-0.6deg);
  }
  .about img {
    display: block;
    filter: grayscale(1) contrast(1.05);
  }
  .frame canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .frame canvas.is-active {
    opacity: 1;
  }
  .frame:has(canvas.is-active) img {
    visibility: hidden;
  }
</style>
