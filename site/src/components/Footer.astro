---
import {formatHoursLine, sortedByWeekStartingSunday, type DayHours} from '../lib/hours'

interface Props {
  shopName: string
  address?: {street?: string; city?: string; state?: string; zip?: string}
  phone?: string
  mapsUrl?: string
  hours?: DayHours[]
  holidayNote?: string
  social?: {platform: string; url: string}[]
}

const {shopName, address, phone, mapsUrl, hours, holidayNote, social} = Astro.props
const orderedHours = hours ? sortedByWeekStartingSunday(hours) : []
const addressLines = [
  address?.street,
  [address?.city, address?.state, address?.zip].filter(Boolean).join(', '),
].filter(Boolean)
---

<footer class="footer container">
  <hr class="ink-rule footer-rule" />
  <div class="col">
    <h3>Hours</h3>
    <ul class="hours-list">
      {orderedHours.map((day) => <li>{formatHoursLine(day)}</li>)}
    </ul>
    {holidayNote && <p class="holiday-note">{holidayNote}</p>}
  </div>
  <div class="col">
    <h3>Visit</h3>
    {addressLines.map((line) => <p>{line}</p>)}
    {phone && <p><a href={`tel:${phone}`}>{phone}</a></p>}
    {mapsUrl && (
      <a class="button button--secondary" href={mapsUrl} target="_blank" rel="noopener">
        Directions
      </a>
    )}
  </div>
  {social && social.length > 0 && (
    <div class="col">
      <h3>Follow</h3>
      <ul class="social-list">
        {social.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener" aria-label={`${link.platform} (opens in new tab)`}>
              {link.platform}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
  <p class="copyright">&copy; {new Date().getFullYear()} {shopName}</p>
</footer>

<style>
  .footer {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-sm) var(--spacing-md);
  }
  .footer-rule {
    grid-column: 1 / -1;
    margin: 0 0 var(--spacing-lg);
  }
  .footer h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-text);
    margin: 0 0 var(--spacing-xs);
    transform: rotate(-1deg);
  }
  .hours-list,
  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
  }
  .hours-list {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .holiday-note {
    font-style: italic;
    color: var(--color-text-muted);
  }
  .copyright {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0;
  }
  .footer a:not(.button) {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: text-decoration-color 150ms ease;
  }
  .footer a:not(.button):hover {
    text-decoration-color: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .footer a:not(.button) {
      transition: none;
    }
  }
</style>
