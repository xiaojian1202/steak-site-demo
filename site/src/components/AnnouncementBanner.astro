---
interface Props {
  message?: string
  link?: string
}

const {message, link} = Astro.props
---

{message && (
  <div class="banner container">
    {link ? (
      <a href={link}>{message}</a>
    ) : (
      <span>{message}</span>
    )}
  </div>
)}

<style>
  .banner {
    background: var(--color-accent);
    color: var(--color-text);
    padding: var(--spacing-xs) var(--spacing-sm);
    text-align: center;
    font-size: 0.9rem;
  }
</style>
